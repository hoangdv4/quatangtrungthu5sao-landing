# Copy thành .env (đã gitignore) — điền giá trị thật trên máy bạn.
# Trên Cloudflare Pages: Settings → Environment variables (KHÔNG commit .env lên git).
#
# LƯU Ý QUAN TRỌNG về "bí mật" với static site:
# - Biến prefix PUBLIC_ sẽ được Astro nhúng thẳng vào HTML/JS gửi tới trình duyệt
#   → về bản chất là CÔNG KHAI với người xem trang. Chúng nằm ở .env chỉ để
#   tách config khỏi code (đổi không cần sửa code) chứ KHÔNG phải để giấu.
# - Bí mật THẬT (Telegram bot token, Sheet ID) không nằm ở đây — chúng nằm trong
#   Script Properties của Google Apps Script, không bao giờ chạm tới repo này.

# Meta Pixel ID (public — ai xem source cũng thấy, giống mọi website chạy Pixel)
PUBLIC_META_PIXEL_ID=

# Google tag ID, dạng AW-XXXXXXXXX hoặc G-XXXXXXXXX (public)
PUBLIC_GTAG_ID=

# URL Web App của Google Apps Script nhận form B2B (public — trình duyệt gọi trực tiếp)
# Lấy sau khi deploy apps-script/Code.gs (xem apps-script/HUONG-DAN.md)
PUBLIC_FORM_ENDPOINT=

# IndexNow key (bán công khai — file key phải đặt ở root site theo giao thức IndexNow)
INDEXNOW_KEY=
