---
// Layout chung cho cả 8 trang. Nhận meta + mảng node JSON-LD từ từng trang.
//
// ⚠️ C0: title/description/OG của trang đích ads KHÔNG được chứa chữ "rượu".
import { SITE } from '../config/site';
import { GIA_MIN, GIA_MAX } from '../lib/pricing';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

// Preload woff2 (subset vietnamese) dùng ngay ở above-the-fold: H1 + body dùng
// chung Be Vietnam Pro 400. URL lấy qua glob để luôn khớp hash build, không hardcode.
const fontUrls = import.meta.glob<string>(
  '../../node_modules/@fontsource/be-vietnam-pro/files/be-vietnam-pro-vietnamese-400-normal.woff2',
  { eager: true, query: '?url', import: 'default' }
);
const preloadFonts = Object.values(fontUrls);

interface Props {
  title: string;
  description: string;
  /** Ngày cập nhật nội dung (ISO) — đổ vào article:modified_time + dateModified. */
  dateModified?: string;
  /** Các node schema.org đưa vào @graph. LocalBusiness luôn được thêm sẵn. */
  schema?: Record<string, unknown>[];
  /** true → noindex (dùng cho trang không muốn index). */
  noindex?: boolean;
  /** URL ảnh hero (LCP element) — preload để giảm LCP trên 4G. */
  preloadImage?: string;
  /** true → Header rút gọn (dùng cho 7 trang chi tiết khách sạn). */
  headerCompact?: boolean;
}

const {
  title,
  description,
  dateModified,
  schema = [],
  noindex = false,
  preloadImage,
  headerCompact = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.domain).href.replace(/\/$/, '') || SITE.domain;
const modified = dateModified ?? new Date().toISOString().slice(0, 10);

const localBusiness = {
  '@type': 'LocalBusiness',
  '@id': `${SITE.domain}/#business`,
  name: SITE.brand,
  description: 'Đại lý phân phối bánh trung thu chính hãng 7 khách sạn 5 sao tại Hà Nội và Sài Gòn.',
  url: SITE.domain,
  telephone: SITE.phone,
  areaServed: SITE.addressLocality,
  priceRange: `${GIA_MIN.toLocaleString('vi-VN')}đ–${GIA_MAX.toLocaleString('vi-VN')}đ`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.addressLocality,
    addressCountry: SITE.addressCountry,
  },
  ...(SITE.email ? { email: SITE.email } : {}),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [localBusiness, ...schema],
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="article:modified_time" content={modified} />
    {preloadImage && <meta property="og:image" content={new URL(preloadImage, SITE.domain).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {preloadImage && <meta name="twitter:image" content={new URL(preloadImage, SITE.domain).href} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    {preloadImage && <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />}

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <Analytics />
  </head>
  <body class="bg-paper text-ink antialiased">
    <Header compact={headerCompact} />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingCTA />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
