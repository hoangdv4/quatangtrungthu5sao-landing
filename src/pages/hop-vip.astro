---
// /hop-vip — ads KHÔNG BAO GIỜ trỏ vào trang này. Ưu tiên sitemap thấp (xem astro.config.mjs).
// ⚠️ C0: được ghi "kèm rượu vang/quà tặng cao cấp", vẫn KHÔNG nêu tên hãng rượu ở bất kỳ đâu.
// Dark luxury duy nhất của site: nền --ink toàn trang, chữ --paper, giá --gold.
import Base from '../layouts/Base.astro';
import { SITE, PHONE_DISPLAY, PHONE_TEL } from '../config/site';
import { KHACH_SAN, dinhDangGia, coQuaTang, duongDan } from '../lib/pricing';

const dateModified = '2026-07-31';
const title = `Hộp VIP — Quà Tặng Thượng Hạng Cho Lãnh Đạo & Đối Tác | ${SITE.brand}`;
const description = `Hộp bánh trung thu VIP kèm quà tặng cao cấp từ 7 khách sạn 5 sao, giá đã VAT. Tư vấn cấu hình riêng theo ngân sách qua Zalo ${PHONE_DISPLAY}.`;

// Nhóm hộp có quà tặng kèm theo khách sạn — chỉ hiển thị ten_hien_thi (đã sanitize), không tên hãng.
const nhomVip = KHACH_SAN.map((ks) => ({
  ks,
  sanPham: ks.san_pham.filter(coQuaTang),
})).filter((n) => n.sanPham.length > 0);

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.domain}/hop-vip#webpage`,
    url: `${SITE.domain}/hop-vip`,
    name: title,
    description,
    inLanguage: 'vi-VN',
    dateModified,
    isPartOf: { '@id': `${SITE.domain}/#business` },
  },
];
---

<Base {title} {description} {dateModified} {schema} noindex={false}>
  <div class="bg-ink text-paper">
    <article class="mx-auto max-w-4xl px-4 py-12 md:py-20">
      <p class="label-gold-dark">Bộ sưu tập thượng hạng</p>
      <h1 class="mt-3 font-display text-[clamp(1.75rem,5vw,2.75rem)] leading-tight text-paper">
        Hộp VIP — Quà tặng thượng hạng cho lãnh đạo & đối tác quan trọng
      </h1>

      <p class="mt-4 max-w-[65ch] text-base leading-relaxed text-paper/80 sm:text-lg">
        Hộp VIP tùy biến — có thể chọn cấu hình quà tặng theo gu và ngân sách, không bó vào cấu hình
        mặc định. Tư vấn riêng qua Zalo {PHONE_DISPLAY}.
      </p>

      <div class="mt-8">
        <a
          href={SITE.zalo}
          target="_blank"
          rel="noopener"
          data-contact="zalo-hero"
          class="inline-block bg-gold px-6 py-3 text-sm font-medium uppercase tracking-wide text-ink hover:bg-paper"
        >
          Chat Zalo tư vấn hộp VIP
        </a>
      </div>

      <div class="mt-12 space-y-10">
        {
          nhomVip.map(({ ks, sanPham }) => (
            <section>
              <h2 class="font-display text-2xl text-paper">
                <a href={duongDan(ks.id)} class="hover:text-gold hover:underline">
                  {ks.ten}
                </a>
              </h2>
              <ul class="mt-4 divide-y divide-paper/15 border border-paper/15">
                {sanPham.map((sp) => (
                  <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3.5">
                    <div>
                      <p class="font-medium text-paper">{sp.ten_hien_thi}</p>
                      <p class="text-sm text-paper/60">{sp.quy_cach}</p>
                    </div>
                    <p class="price text-gold">{dinhDangGia(sp.gia_da_vat)}</p>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <div class="mt-12 border-t border-paper/15 pt-6 text-sm text-paper/60">
        <p>Cập nhật ngày 31/07/2026.</p>
        <p class="mt-1">
          Liên hệ {SITE.brand}:
          <a href={`tel:${PHONE_TEL}`} data-contact="hotline-footer" class="font-medium text-paper underline decoration-gold-soft underline-offset-4"
            >{PHONE_DISPLAY}</a
          >
          ·
          <a href={SITE.zalo} target="_blank" rel="noopener" data-contact="zalo-footer" class="font-medium text-paper underline decoration-gold-soft underline-offset-4"
            >Zalo</a
          >
        </p>
      </div>
    </article>
  </div>
</Base>
