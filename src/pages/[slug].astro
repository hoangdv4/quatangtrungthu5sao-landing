---
// 7 trang con khách sạn — cấu trúc mới theo design_handoff_trungthu_landing/README.md mục 2.
// ⚠️ C0: trang đích ads — không chữ "rượu" trong meta/OG, ten_hien_thi đã sanitize.
export const prerender = true;

import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BangGia from '../components/BangGia.astro';
import Lightbox from '../components/Lightbox.astro';
import RelatedHotels from '../components/RelatedHotels.astro';
import { SITE, PHONE_DISPLAY, PHONE_TEL } from '../config/site';
import { KHACH_SAN, duongDan, dinhDangGia, type KhachSan } from '../lib/pricing';
import { FAQ_CHUAN, faqGiaoHang, faqSchema, type FaqItem } from '../lib/faq';
import { HOTEL_CONTENT } from '../lib/hotel-content';
import { anhKhachSan, layLogo } from '../lib/hotel-images';
import { HOTEL_STORY } from '../lib/hotel-story';

export function getStaticPaths() {
  return KHACH_SAN.map((ks) => ({
    params: { slug: duongDan(ks.id).replace(/^\//, '') },
    props: { ks },
  }));
}

interface Props {
  ks: KhachSan;
}

const { ks } = Astro.props;
const content = HOTEL_CONTENT[ks.id];
const dateModified = '2026-07-31';

const min = dinhDangGia(ks.gia_tu);
const max = dinhDangGia(ks.gia_den);
const soMau = ks.san_pham.length;
const story = HOTEL_STORY[ks.id];
const logo = layLogo(ks.id);

const tenTrangThai = story?.ten_bst ? `${ks.ten} — BST ${story.ten_bst}` : ks.ten;
const title = `Bánh Trung Thu ${tenTrangThai} 2026: Bảng Giá Từ ${min} | ${SITE.brand}`;
const description = `Bảng giá ${soMau} hộp bánh trung thu ${ks.ten} 2026 đã VAT, tư vấn chọn hộp theo ngân sách. Giao nhanh 24–48h tại ${ks.thanh_pho}. Zalo ${PHONE_DISPLAY}.`;

const doanMo = `Bánh trung thu ${ks.ten} 2026 có ${soMau} loại hộp, giá từ ${min} đến ${max} (đã gồm VAT). Đặt qua đại lý phân phối ${SITE.brand}, giao nhanh 24–48h tại ${ks.thanh_pho}, ship toàn quốc. Liên hệ Zalo ${PHONE_DISPLAY}.`;

// FAQ trang = 2 câu chung + câu giao hàng theo đúng thành phố + 3 câu chung còn lại + câu riêng KS.
const faqTrang: FaqItem[] = [
  FAQ_CHUAN[0],
  FAQ_CHUAN[1],
  faqGiaoHang(ks.thanh_pho),
  ...FAQ_CHUAN.slice(2),
  ...content.faqRieng,
];

const canonicalPath = duongDan(ks.id);
const anh = anhKhachSan(ks.id);
const [anhHero, ...anhConLai] = anh;
const anhHeroOptimized = anhHero
  ? await getImage({ src: anhHero, width: 1600, height: 1600 })
  : null;

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.domain}${canonicalPath}#webpage`,
    url: `${SITE.domain}${canonicalPath}`,
    name: title,
    description,
    inLanguage: 'vi-VN',
    dateModified,
    isPartOf: { '@id': `${SITE.domain}/#business` },
  },
  {
    '@type': 'Product',
    name: `Bánh trung thu ${ks.ten} 2026`,
    description: doanMo,
    ...(anhHeroOptimized ? { image: `${SITE.domain}${anhHeroOptimized.src}` } : {}),
    brand: { '@type': 'Brand', name: SITE.brand },
    offers: ks.san_pham.map((sp) => ({
      '@type': 'Offer',
      name: sp.ten_hien_thi,
      priceCurrency: 'VND',
      price: sp.gia_da_vat,
      availability: 'https://schema.org/InStock',
      url: `${SITE.domain}${canonicalPath}`,
      seller: { '@id': `${SITE.domain}/#business` },
    })),
  },
  faqSchema(faqTrang),
];
---

<Base {title} {description} {dateModified} {schema} headerCompact preloadImage={anhHeroOptimized?.src}>
  <div class="mx-auto max-w-[1180px] px-6 pt-6 sm:px-10">
    <nav aria-label="Breadcrumb" class="flex items-center gap-3 text-xs text-text-faint">
      <a href="/#catalogue" class="text-accent hover:text-accent-hover">Bộ sưu tập</a>
      <span aria-hidden="true">/</span>
      <span>{ks.ten} 2026</span>
      {logo && <img src={logo} alt={`Logo ${ks.ten}`} class="ml-2 h-8 w-auto object-contain" loading="lazy" />}
    </nav>
  </div>

  <article class="mx-auto max-w-[1180px] px-6 py-8 sm:px-10 md:py-12">
    {/* ── Thân trên: gallery + thông tin ─────────────────────────── */}
    <div class="grid gap-14 lg:grid-cols-[1.05fr_.95fr] lg:items-start">
      <div data-reveal>
        {
          anhHero && (
            <Image
              src={anhHero}
              alt={`Bánh trung thu ${ks.ten} 2026 — hộp quà chính hãng`}
              width={1600}
              height={1600}
              loading="eager"
              fetchpriority="high"
              class="h-[460px] w-full object-cover"
            />
          )
        }
        {
          anhConLai.length > 0 && (
            <div class="mt-3">
              <Lightbox
                id={ks.id}
                images={anhConLai}
                altAt={(i) => `Bánh trung thu ${ks.ten} 2026 — cận cảnh hộp bánh ${i + 2}`}
              />
            </div>
          )
        }
      </div>

      <div data-reveal>
        {story?.ten_bst && <p class="label-gold">{story.ten_bst} · Trung Thu 2026</p>}
        <h1 class="mt-2 font-display text-[clamp(1.75rem,5vw,3.25rem)] font-light leading-[1.05] text-ink">
          Bánh trung thu {ks.ten}
        </h1>
        <p class="price mt-3 text-xl">{min} – {max}</p>
        <p class="mt-1 text-[13px] text-text-faint">
          {soMau} mẫu hộp · HSD {ks.hsd_ngay} ngày · giá đã bao gồm VAT
        </p>

        <div class="mt-6 grid grid-cols-1 gap-3 border-t border-b border-hairline py-5 text-[13px] text-text-muted sm:grid-cols-2">
          <p>Nhận trực tiếp từ khách sạn, nguyên tem nguyên hộp</p>
          <p>Hóa đơn VAT đầy đủ, công nợ 50% cho đơn doanh nghiệp</p>
        </div>

        <h2 class="mt-8 font-display text-2xl text-ink">
          Bảng giá bánh trung thu {ks.ten} 2026 (đã gồm VAT)
        </h2>
        <div class="mt-4">
          <BangGia hotelId={ks.id} sanPham={ks.san_pham} />
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={SITE.zalo}
            target="_blank"
            rel="noopener"
            data-contact="zalo-hero"
            class="bg-accent px-7 py-4 text-sm font-medium uppercase tracking-wide text-paper hover:bg-accent-hover"
          >
            Chat Zalo — báo giá 30 phút
          </a>
          <a
            href={`tel:${PHONE_TEL}`}
            data-contact="hotline-hero"
            class="border border-hairline-input px-7 py-4 text-sm font-medium uppercase tracking-wide text-ink hover:bg-paper-warm"
          >
            Gọi {PHONE_DISPLAY}
          </a>
        </div>

        <ul class="mt-6 space-y-2 text-[13px] text-text-muted">
          <li class="flex gap-3"><span aria-hidden="true" class="text-gold">—</span>HSD {ks.hsd_ngay} ngày kể từ ngày sản xuất</li>
          <li class="flex gap-3"><span aria-hidden="true" class="text-gold">—</span>Giao 24–48h nội thành {ks.thanh_pho}, toàn quốc 2–4 ngày</li>
          <li class="flex gap-3"><span aria-hidden="true" class="text-gold">—</span>Thiết kế hộp riêng với logo công ty</li>
        </ul>

        {
          story?.catalogue && (
            <a
              href={`/catalogue/${story.catalogue}`}
              target="_blank"
              rel="noopener"
              data-contact="catalogue-download"
              class="mt-5 inline-block border border-gold px-5 py-2.5 text-sm font-medium uppercase tracking-wide text-accent hover:bg-gold hover:text-ink"
            >
              Tải catalogue chính hãng (PDF)
            </a>
          )
        }
      </div>
    </div>

    {/* ── Khối lời giới thiệu BST (chỉ hiện nếu có nội dung thật) ── */}
    {
      story?.loiTua && (
        <div data-reveal class="mt-14 grid gap-12 bg-paper-warm p-8 sm:p-11 md:grid-cols-2">
          <div>
            <p class="max-w-[65ch] font-display text-[1.5rem] font-light italic leading-[1.55] text-ink">
              {story.loiTua}
            </p>
            <p class="mt-6 text-xs uppercase tracking-[.14em] text-accent">
              BST {story.ten_bst ?? ks.ten}
            </p>
          </div>
          {
            anh[1] && (
              <Image
                src={anh[1]}
                alt={`Bộ sưu tập bánh trung thu ${ks.ten} 2026`}
                width={800}
                height={520}
                loading="lazy"
                class="h-[260px] w-full object-cover"
              />
            )
          }
        </div>
      )
    }

    {/* ── Khách sạn khác ─────────────────────────────────────────── */}
    <div class="mt-14">
      <RelatedHotels hienTai={ks.id} />
    </div>

    {/* ── CTA cuối ─────────────────────────────────────────────────── */}
    <div data-reveal class="mt-14 flex flex-col items-center gap-4 bg-ink p-8 text-center sm:flex-row sm:justify-between sm:text-left">
      <div>
        <p class="font-display text-xl text-dark-text">Đặt từ 30 hộp trở lên?</p>
        <p class="mt-1 text-[13px] text-dark-text-muted">Chiết khấu tốt · hóa đơn VAT đầy đủ · logo và thiệp công ty</p>
      </div>
      <a
        href={SITE.zalo}
        target="_blank"
        rel="noopener"
        data-contact="zalo-cta-cuoi"
        class="inline-block bg-gold px-6 py-3 text-sm font-medium uppercase tracking-wide text-ink hover:bg-paper"
      >
        Chat Zalo — báo giá 30 phút
      </a>
      <p class="text-xs text-dark-text-muted sm:hidden">Cập nhật ngày 31/07/2026.</p>
    </div>
  </article>
</Base>
