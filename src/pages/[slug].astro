---
// 7 trang con khách sạn — khuôn theo data/site-content.md mục 2.
// ⚠️ C0: trang đích ads — không chữ "rượu" trong meta/OG, ten_hien_thi đã sanitize.
export const prerender = true;

import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BangGia from '../components/BangGia.astro';
import { SITE, PHONE_DISPLAY, PHONE_TEL } from '../config/site';
import { KHACH_SAN, duongDan, dinhDangGia, type KhachSan } from '../lib/pricing';
import { FAQ_CHUAN, faqGiaoHang, faqSchema, type FaqItem } from '../lib/faq';
import { HOTEL_CONTENT } from '../lib/hotel-content';
import { anhKhachSan } from '../lib/hotel-images';
import { HOTEL_STORY } from '../lib/hotel-story';

export function getStaticPaths() {
  return KHACH_SAN.map((ks) => ({
    params: { slug: duongDan(ks.id).replace(/^\//, '') },
    props: { ks },
  }));
}

interface Props {
  ks: KhachSan;
}

const { ks } = Astro.props;
const content = HOTEL_CONTENT[ks.id];
const dateModified = '2026-07-31';

const min = dinhDangGia(ks.gia_tu);
const max = dinhDangGia(ks.gia_den);
const soMau = ks.san_pham.length;
const story = HOTEL_STORY[ks.id];

const tenTrangThai = story?.ten_bst ? `${ks.ten} — BST ${story.ten_bst}` : ks.ten;
const title = `Bánh Trung Thu ${tenTrangThai} 2026: Bảng Giá Từ ${min} | ${SITE.brand}`;
const description = `Bảng giá ${soMau} hộp bánh trung thu ${ks.ten} 2026 đã VAT, tư vấn chọn hộp theo ngân sách. Giao nhanh 24–48h tại ${ks.thanh_pho}. Zalo ${PHONE_DISPLAY}.`;

const doanMo = `Bánh trung thu ${ks.ten} 2026 có ${soMau} loại hộp, giá từ ${min} đến ${max} (đã gồm VAT). Đặt qua đại lý phân phối ${SITE.brand}, giao nhanh 24–48h tại ${ks.thanh_pho}, ship toàn quốc. Liên hệ Zalo ${PHONE_DISPLAY}.`;

// FAQ trang = 2 câu chung + câu giao hàng theo đúng thành phố + 3 câu chung còn lại + câu riêng KS.
const faqTrang: FaqItem[] = [
  FAQ_CHUAN[0],
  FAQ_CHUAN[1],
  faqGiaoHang(ks.thanh_pho),
  ...FAQ_CHUAN.slice(2),
  ...content.faqRieng,
];

const canonicalPath = duongDan(ks.id);
const anh = anhKhachSan(ks.id);
const [anhHero, ...anhConLai] = anh;

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.domain}${canonicalPath}#webpage`,
    url: `${SITE.domain}${canonicalPath}`,
    name: title,
    description,
    inLanguage: 'vi-VN',
    dateModified,
    isPartOf: { '@id': `${SITE.domain}/#business` },
  },
  {
    '@type': 'Product',
    name: `Bánh trung thu ${ks.ten} 2026`,
    description: doanMo,
    brand: { '@type': 'Brand', name: SITE.brand },
    offers: ks.san_pham.map((sp) => ({
      '@type': 'Offer',
      name: sp.ten_hien_thi,
      priceCurrency: 'VND',
      price: sp.gia_da_vat,
      availability: 'https://schema.org/InStock',
      url: `${SITE.domain}${canonicalPath}`,
      seller: { '@id': `${SITE.domain}/#business` },
    })),
  },
  faqSchema(faqTrang),
];
---

<Base {title} {description} {dateModified} {schema}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-bold leading-tight text-slate-900 sm:text-4xl">
      Bánh trung thu {ks.ten} 2026: Bảng giá, các hộp, mua ở đâu
    </h1>

    <p class="mt-4 text-base leading-relaxed text-slate-700 sm:text-lg">
      {doanMo}
    </p>

    {
      story?.loiTua && (
        <p class="mt-4 border-l-4 border-son-200 pl-4 text-base leading-relaxed text-slate-600 italic sm:text-lg">
          {story.loiTua}
        </p>
      )
    }

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={SITE.zalo}
        target="_blank"
        rel="noopener"
        data-contact="zalo-hero"
        class="rounded-lg bg-son-600 px-6 py-3 text-base font-semibold text-white hover:bg-son-700"
      >
        Chat Zalo {PHONE_DISPLAY}
      </a>
      <a
        href={`tel:${PHONE_TEL}`}
        data-contact="hotline-hero"
        class="rounded-lg border-2 border-son-600 px-6 py-3 text-base font-semibold text-son-700 hover:bg-son-50"
      >
        Gọi ngay
      </a>
      {
        story?.catalogue && (
          <a
            href={`/catalogue/${story.catalogue}`}
            target="_blank"
            rel="noopener"
            data-contact="catalogue-download"
            class="rounded-lg px-6 py-3 text-base font-semibold text-slate-700 underline hover:text-son-700"
          >
            Tải catalogue chính hãng (PDF)
          </a>
        )
      }
    </div>

    {
      anhHero && (
        <div class="mt-8 overflow-hidden rounded-xl">
          <Image
            src={anhHero}
            alt={`Bánh trung thu ${ks.ten} 2026 — hộp quà chính hãng`}
            width={1200}
            height={900}
            loading="eager"
            class="w-full object-cover"
          />
        </div>
      )
    }

    {
      anhConLai.length > 0 && (
        <div class="mt-3 grid grid-cols-3 gap-3">
          {anhConLai.map((img, i) => (
            <Image
              src={img}
              alt={`Bánh trung thu ${ks.ten} 2026 — cận cảnh hộp bánh ${i + 2}`}
              width={400}
              height={300}
              loading="lazy"
              class="aspect-4/3 w-full rounded-lg object-cover"
            />
          ))}
        </div>
      )
    }

    <h2 class="mt-10 text-2xl font-bold text-slate-900">
      Bảng giá bánh trung thu {ks.ten} 2026 (đã gồm VAT)
    </h2>
    <div class="mt-4">
      <BangGia sanPham={ks.san_pham} />
    </div>
    <p class="mt-3 text-sm text-slate-600">
      Hạn sử dụng {ks.hsd_ngay} ngày kể từ ngày sản xuất.
    </p>

    <h2 class="mt-10 text-2xl font-bold text-slate-900">Nên chọn hộp nào?</h2>
    <p class="mt-3 leading-relaxed text-slate-700">{content.tuVan}</p>

    <h2 class="mt-10 text-2xl font-bold text-slate-900">Câu hỏi thường gặp</h2>
    <div class="mt-4 space-y-3">
      {
        faqTrang.map((item, i) => (
          <details class="rounded-lg bg-son-50 p-4" open={i === 0}>
            <summary class="cursor-pointer font-semibold text-slate-900">{item.q}</summary>
            <p class="mt-2 text-slate-700">{item.a}</p>
          </details>
        ))
      }
    </div>

    <div class="mt-10 rounded-xl bg-son-50 p-5 text-sm text-slate-700">
      <p>Cập nhật ngày 31/07/2026.</p>
      <p class="mt-1">
        Liên hệ {SITE.brand}:
        <a href={`tel:${PHONE_TEL}`} data-contact="hotline-footer" class="font-semibold text-son-700 underline"
          >{PHONE_DISPLAY}</a
        >
        · <a href={SITE.zalo} target="_blank" rel="noopener" data-contact="zalo-footer" class="font-semibold text-son-700 underline">Zalo</a>
      </p>
    </div>
  </article>
</Base>
