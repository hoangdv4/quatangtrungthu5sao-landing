---
// 7 trang con khách sạn — cấu trúc mới theo design_handoff_trungthu_landing/README.md mục 2.
// ⚠️ C0: trang đích ads — không chữ "rượu" trong meta/OG, ten_hien_thi đã sanitize.
export const prerender = true;

import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BangGiaTheAnh from '../components/BangGiaTheAnh.astro';
import RelatedHotels from '../components/RelatedHotels.astro';
import { SITE, PHONE_DISPLAY, PHONE_TEL } from '../config/site';
import { KHACH_SAN, duongDan, dinhDangGia, type KhachSan } from '../lib/pricing';
import { FAQ_CHUAN, faqGiaoHang, faqSchema, type FaqItem } from '../lib/faq';
import { HOTEL_CONTENT } from '../lib/hotel-content';
import { anhKhachSan, layLogo } from '../lib/hotel-images';
import { HOTEL_STORY } from '../lib/hotel-story';

export function getStaticPaths() {
  return KHACH_SAN.map((ks) => ({
    params: { slug: duongDan(ks.id).replace(/^\//, '') },
    props: { ks },
  }));
}

interface Props {
  ks: KhachSan;
}

const { ks } = Astro.props;
const content = HOTEL_CONTENT[ks.id];
const dateModified = '2026-07-31';

const min = dinhDangGia(ks.gia_tu);
const max = dinhDangGia(ks.gia_den);
const soMau = ks.san_pham.length;
const story = HOTEL_STORY[ks.id];
const logo = layLogo(ks.id);

const title = `Bánh Trung Thu ${ks.ten} 2026 | ${SITE.brand}`;
const description = `Bảng giá ${soMau} hộp bánh trung thu ${ks.ten} 2026 đã VAT. Giao nhanh 24–48h tại ${ks.thanh_pho}. Zalo ${PHONE_DISPLAY}.`;

const doanMo = `Bánh trung thu ${ks.ten} 2026 có ${soMau} loại hộp, giá từ ${min} đến ${max} (đã gồm VAT). Đặt qua đại lý phân phối ${SITE.brand}, giao nhanh 24–48h tại ${ks.thanh_pho}, ship toàn quốc. Liên hệ Zalo ${PHONE_DISPLAY}.`;

// FAQ trang = 2 câu chung + câu giao hàng theo đúng thành phố + 3 câu chung còn lại + câu riêng KS.
const faqTrang: FaqItem[] = [
  FAQ_CHUAN[0],
  FAQ_CHUAN[1],
  faqGiaoHang(ks.thanh_pho),
  ...FAQ_CHUAN.slice(2),
  ...content.faqRieng,
];

const canonicalPath = duongDan(ks.id);
const [anhHero] = anhKhachSan(ks.id);
const anhHeroOptimized = anhHero
  ? await getImage({ src: anhHero, width: 1600, height: 1600 })
  : null;

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.domain}${canonicalPath}#webpage`,
    url: `${SITE.domain}${canonicalPath}`,
    name: title,
    description,
    inLanguage: 'vi-VN',
    dateModified,
    isPartOf: { '@id': `${SITE.domain}/#business` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: SITE.domain },
      { '@type': 'ListItem', position: 2, name: `${ks.ten} 2026`, item: `${SITE.domain}${canonicalPath}` },
    ],
  },
  {
    '@type': 'Product',
    name: `Bánh trung thu ${ks.ten} 2026`,
    description: doanMo,
    ...(anhHeroOptimized ? { image: `${SITE.domain}${anhHeroOptimized.src}` } : {}),
    brand: { '@type': 'Brand', name: SITE.brand },
    offers: ks.san_pham.map((sp) => ({
      '@type': 'Offer',
      name: sp.ten_hien_thi,
      priceCurrency: 'VND',
      price: sp.gia_da_vat,
      availability: 'https://schema.org/InStock',
      url: `${SITE.domain}${canonicalPath}`,
      seller: { '@id': `${SITE.domain}/#business` },
    })),
  },
  faqSchema(faqTrang),
];
---

<Base {title} {description} {dateModified} {schema} headerCompact preloadImage={anhHeroOptimized?.src}>
  <div class="mx-auto max-w-[1180px] px-6 pt-6 sm:px-10">
    <nav aria-label="Breadcrumb" class="flex items-center gap-3 text-xs text-text-faint">
      <a href="/#catalogue" class="text-accent hover:text-accent-hover">Bộ sưu tập</a>
      <span aria-hidden="true">/</span>
      <span>{ks.ten} 2026</span>
      {logo && <img src={logo} alt={`Logo ${ks.ten}`} class="ml-2 h-8 w-auto object-contain" loading="lazy" />}
    </nav>
  </div>

  <article class="mx-auto max-w-[1180px] px-6 py-8 sm:px-10 md:py-12">
    {/* ── Hero: lời giới thiệu bộ sưu tập ─────────────────────────── */}
    <div class="grid gap-8 border-b border-hairline pb-10 md:gap-[60px] md:pb-[60px] lg:grid-cols-[1.15fr_.85fr] lg:items-center">
      <div data-reveal class="flex flex-col gap-5">
        <p class="text-[11px] uppercase tracking-[.22em] text-accent">
          {story?.ten_bst ?? ks.ten} · Trung Thu 2026
        </p>
        <h1 class="font-display text-[clamp(2.25rem,5vw,3.375rem)] font-light leading-[1.05] tracking-[-.012em] text-ink">
          Bánh trung thu {ks.ten}
        </h1>
        {
          story?.loiTua ? (
            <p class="max-w-[60ch] text-balance font-display text-[clamp(1.125rem,2.4vw,1.375rem)] font-light italic leading-[1.6] text-[#4a453d]">
              {story.loiTua}
            </p>
          ) : (
            <p class="max-w-[60ch] text-[clamp(1.125rem,2.4vw,1.375rem)] italic leading-[1.6] text-text-faint">
              TODO: chờ lời giới thiệu bộ sưu tập chính thức từ {ks.ten}.
            </p>
          )
        }

        <div class="flex flex-wrap gap-x-8 gap-y-3.5 border-t border-hairline pt-0.5">
          <div class="flex flex-col gap-1 pt-3.5">
            <span class="text-[10px] uppercase tracking-[.13em] text-text-faint">Khoảng giá *</span>
            <span class="price [font-variant-numeric:tabular-nums] text-[17px]">{min} – {max}</span>
          </div>
          <div class="flex flex-col gap-1 pt-3.5">
            <span class="text-[10px] uppercase tracking-[.13em] text-text-faint">Số mẫu hộp</span>
            <span class="text-[17px] text-ink">{soMau} mẫu</span>
          </div>
          <div class="flex flex-col gap-1 pt-3.5">
            <span class="text-[10px] uppercase tracking-[.13em] text-text-faint">Hạn sử dụng</span>
            <span class="text-[17px] text-ink">{ks.hsd_ngay} ngày</span>
          </div>
        </div>

        <div class="flex flex-wrap gap-3.5 pt-1">
          <a
            href={SITE.zalo}
            target="_blank"
            rel="noopener"
            data-contact="zalo-hero"
            class="bg-accent px-7 py-4 text-[13px] font-medium tracking-[.05em] text-paper hover:bg-accent-hover"
          >
            Chat Zalo — báo giá 30 phút
          </a>
          <a
            href={`tel:${PHONE_TEL}`}
            data-contact="hotline-hero"
            class="border border-hairline-input px-6 py-4 text-[13px] font-medium text-ink hover:bg-paper-warm"
          >
            Gọi {PHONE_DISPLAY}
          </a>
        </div>

        {
          story?.catalogue && (
            <a
              href={`/catalogue/${story.catalogue}`}
              target="_blank"
              rel="noopener"
              data-contact="catalogue-download"
              class="inline-block w-fit border border-gold px-5 py-2.5 text-sm font-medium uppercase tracking-wide text-accent hover:bg-gold hover:text-ink"
            >
              Tải catalogue chính hãng (PDF)
            </a>
          )
        }
      </div>

      <div data-reveal class="flex flex-col gap-3">
        {
          anhHero && (
            <div class="relative h-[300px] sm:h-[440px]">
              <Image
                src={anhHero}
                alt={`Bộ sưu tập bánh trung thu ${ks.ten} 2026`}
                width={1200}
                height={1500}
                loading="eager"
                fetchpriority="high"
                class="h-full w-full object-cover"
              />
            </div>
          )
        }
        <p class="text-[11px] uppercase tracking-[.13em] text-accent">
          BST {story?.ten_bst ?? ks.ten}
        </p>
      </div>
    </div>

    {/* ── Bảng giá dạng thẻ có ảnh ─────────────────────────────────── */}
    <div data-reveal class="flex flex-col gap-[26px] pt-14">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="text-[11px] uppercase tracking-[.22em] text-accent">Bảng giá 2026</p>
          <h2 class="mt-2 font-display text-[38px] leading-[1.1] text-ink">Toàn bộ {soMau} mẫu hộp</h2>
        </div>
        <p class="pb-1.5 text-xs text-text-faint">* Giá niêm yết đã bao gồm VAT.</p>
      </div>

      <BangGiaTheAnh hotelId={ks.id} sanPham={ks.san_pham} />

      <div class="mt-1.5 grid gap-6 border-t border-hairline pt-[26px] sm:grid-cols-3">
        <p class="flex gap-3 text-[13px] leading-[1.6] text-[#4a453d]">
          <span aria-hidden="true" class="text-gold">—</span>Nhận trực tiếp từ khách sạn, nguyên tem nguyên hộp
        </p>
        <p class="flex gap-3 text-[13px] leading-[1.6] text-[#4a453d]">
          <span aria-hidden="true" class="text-gold">—</span>Giao 24–48h nội thành {ks.thanh_pho}, toàn quốc 2–4 ngày
        </p>
        <p class="flex gap-3 text-[13px] leading-[1.6] text-[#4a453d]">
          <span aria-hidden="true" class="text-gold">—</span>Thiết kế hộp riêng với logo công ty
        </p>
      </div>
    </div>

    {/* ── Khách sạn khác ─────────────────────────────────────────── */}
    <div class="mt-14">
      <RelatedHotels hienTai={ks.id} />
    </div>

    {/* ── CTA cuối ─────────────────────────────────────────────────── */}
    <div data-reveal class="mt-14 flex flex-col items-center gap-4 bg-ink p-8 text-center sm:flex-row sm:justify-between sm:text-left">
      <div>
        <p class="font-display text-xl text-dark-text">Đặt từ 30 hộp trở lên?</p>
        <p class="mt-1 text-[13px] text-dark-text-muted">Chiết khấu tốt · hóa đơn VAT đầy đủ · logo và thiệp công ty</p>
      </div>
      <a
        href={SITE.zalo}
        target="_blank"
        rel="noopener"
        data-contact="zalo-cta-cuoi"
        class="inline-block bg-gold px-6 py-3 text-sm font-medium uppercase tracking-wide text-ink hover:bg-paper"
      >
        Chat Zalo — báo giá 30 phút
      </a>
      <p class="text-xs text-dark-text-muted sm:hidden">Cập nhật ngày 31/07/2026.</p>
    </div>
  </article>
</Base>
