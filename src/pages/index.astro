---
// Trang chủ — 10 khối theo design_handoff_trungthu_landing/README.md (redesign luxury).
// ⚠️ C0: đây là TRANG ĐÍCH CỦA ADS — không chữ "rượu" trong meta/OG,
// không liệt kê hộp VIP kèm giá, không tên hãng rượu ở bất kỳ đâu.
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FormB2B from '../components/FormB2B.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import LogoStrip from '../components/LogoStrip.astro';
import BangGiaTongHop from '../components/BangGiaTongHop.astro';
import { SITE, PHONE_DISPLAY, PHONE_TEL } from '../config/site';
import {
  KHACH_SAN,
  duongDan,
  dinhDangGia,
  tinhTiers,
  GIA_MIN,
  GIA_MAX,
  TONG_SO_MAU,
  PAGE_MODIFIED,
} from '../lib/pricing';
import { FAQ_CHUAN, faqSchema } from '../lib/faq';
import { anhKhachSan, ANH_SMA } from '../lib/hotel-images';
import { HOTEL_STORY } from '../lib/hotel-story';

const title = `Bánh Trung Thu Khách Sạn 5 Sao 2026 | ${SITE.brand}`;
const description = `Bảng giá bánh trung thu 7 khách sạn 5 sao 2026: Sheraton, InterContinental, Meliá... Chính hãng, đã VAT, giao nhanh HN & SG. Zalo ${PHONE_DISPLAY}.`;
const dateModified = PAGE_MODIFIED['/'];

// Khối 7 — chọn theo ngân sách. Danh sách theo site-content.md, giá lấy từ pricing.json.
const nhomNganSach = [
  {
    nhan: 'Dưới 1,1 triệu',
    mo_ta: 'Biếu số lượng cho nhân viên, đối tác phổ thông',
    items: [
      { ks: 'sheraton', stt: 1 },
      { ks: 'sheraton', stt: 2 },
      { ks: 'intercontinental-lm72', stt: 1 },
      { ks: 'melia', stt: 1 },
      { ks: 'melia', stt: 2 },
    ],
  },
  {
    nhan: '1,2 – 2,6 triệu',
    mo_ta: 'Biếu sếp, khách hàng thân thiết, gia đình',
    items: [
      { ks: 'sofitel', stt: 1 },
      { ks: 'nikko', stt: 2 },
      { ks: 'sheraton', stt: 3 },
      { ks: 'renaissance', stt: 1 },
      { ks: 'sofitel', stt: 2 },
      { ks: 'hilton', stt: 1 },
      { ks: 'melia', stt: 3 },
      { ks: 'intercontinental-lm72', stt: 3 },
      { ks: 'sofitel', stt: 3 },
    ],
  },
];

// Ghép tên + giá từ pricing.json (không hardcode giá).
const nhomDaDo = nhomNganSach.map((nhom) => ({
  ...nhom,
  san_pham: nhom.items.flatMap(({ ks, stt }) => {
    const hotel = KHACH_SAN.find((h) => h.id === ks);
    const sp = hotel?.san_pham.find((p) => p.stt === stt);
    return sp && hotel ? [{ hotel, sp }] : [];
  }),
}));

// Khối 3 — Hero slideshow: collage 3 ảnh mỗi khách sạn (1 lớn + 2 nhỏ), đúng thứ tự KHACH_SAN.
const slides = KHACH_SAN.map((ks) => ({
  ks,
  anh: anhKhachSan(ks.id).slice(0, 3),
  tenBst: HOTEL_STORY[ks.id]?.ten_bst ?? null,
})).filter((s) => s.anh.length > 0);

const anhHeroOptimized = slides[0] ? await getImage({ src: slides[0].anh[0], width: 2400, height: 860 }) : null;

// Khối 6 — bảng giá tổng hợp: ảnh đại diện + tier tính từ giá thật.
const bangGiaRows = KHACH_SAN.map((ks) => ({
  ks,
  anh: anhKhachSan(ks.id)[0],
  tiers: tinhTiers(ks),
}));

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.domain}/#webpage`,
    url: SITE.domain,
    name: title,
    description,
    inLanguage: 'vi-VN',
    dateModified,
    isPartOf: { '@id': `${SITE.domain}/#business` },
  },
  {
    '@type': 'ItemList',
    name: 'Bánh trung thu 7 khách sạn 5 sao 2026',
    numberOfItems: KHACH_SAN.length,
    itemListElement: KHACH_SAN.map((ks, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `Bánh trung thu ${ks.ten} 2026`,
      url: `${SITE.domain}${duongDan(ks.id)}`,
    })),
  },
  {
    '@type': 'Product',
    name: 'Bánh trung thu khách sạn 5 sao 2026',
    description:
      'Hộp bánh trung thu chính hãng từ 7 khách sạn 5 sao tại Hà Nội và Sài Gòn, giá niêm yết đã gồm VAT.',
    ...(anhHeroOptimized ? { image: `${SITE.domain}${anhHeroOptimized.src}` } : {}),
    brand: { '@type': 'Brand', name: SITE.brand },
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'VND',
      lowPrice: GIA_MIN,
      highPrice: GIA_MAX,
      offerCount: TONG_SO_MAU,
      availability: 'https://schema.org/InStock',
      seller: { '@id': `${SITE.domain}/#business` },
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'VND' },
        shippingDestination: {
          '@type': 'DefinedRegion',
          addressCountry: SITE.addressCountry,
        },
        deliveryTime: {
          '@type': 'ShippingDeliveryTime',
          handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' },
          transitTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 4, unitCode: 'DAY' },
        },
      },
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy',
        applicableCountry: SITE.addressCountry,
        returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
      },
    },
  },
  faqSchema(FAQ_CHUAN),
];

// Khối 5 — dải 4 ý tin cậy có icon (SVG path lấy nguyên từ design_handoff_trungthu_landing).
const trustPoints = [
  {
    title: 'Chính hãng khách sạn',
    desc: 'Đầy đủ hợp đồng phân phối với khách sạn, nguyên tem nguyên hộp.',
    path: 'M16 8.6l1.7 3.4 3.8.55-2.75 2.7.65 3.8-3.4-1.8-3.4 1.8.65-3.8-2.75-2.7 3.8-.55z',
    extra: 'M11.4 20.4L9.6 28l6.4-3 6.4 3-1.8-7.6',
    circle: true,
  },
  {
    title: 'Giao hàng toàn quốc',
    desc: 'Nội thành Hà Nội 24–48h, toàn quốc 2–4 ngày.',
    path: 'M2 20h15V10H2v10z',
    extra: 'M17 13h6.5l4.5 4.5V20H17v-7z',
  },
  {
    title: 'Hóa đơn doanh nghiệp',
    desc: 'Hóa đơn VAT đầy đủ, giá niêm yết đã gồm VAT.',
    path: 'M7 3.5h13l5 5v20H7v-25z',
    extra: 'M19.5 3.5v5.5H25 M11 15h10M11 19.5h10M11 24h6',
  },
  {
    title: 'Hỗ trợ 24/7',
    desc: 'Zalo và hotline trả lời cả cuối tuần.',
    path: 'M6.5 19v-4a9.5 9.5 0 0119 0v4',
    extra: 'M6.5 15.5H4.2v6h2.3zM25.5 15.5h2.3v6h-2.3z M25.5 21.5v2.2a3.3 3.3 0 01-3.3 3.3H17',
  },
];
---

<Base {title} {description} {dateModified} {schema} preloadImage={anhHeroOptimized?.src}>
  {/* ── Khối 1 — Hero (chữ) ────────────────────────────────────── */}
  <section class="mx-auto flex max-w-[1180px] flex-col items-center gap-6 px-6 py-16 text-center sm:px-10 sm:py-20">
    <div class="flex items-center gap-3">
      <span class="h-px w-7 bg-gold" aria-hidden="true"></span>
      <p class="text-[11px] uppercase tracking-[.28em] text-accent">Trung Thu 2026</p>
      <span class="h-px w-7 bg-gold" aria-hidden="true"></span>
    </div>
    <h1 class="max-w-3xl text-balance font-display text-[clamp(2.25rem,7vw,4.5rem)] leading-[1.04] tracking-[-.015em] text-ink">
      Quà Trung Thu<br />Khách Sạn 5 Sao
    </h1>
  </section>

  {/* ── Khối 2 — Dải logo 7 khách sạn ──────────────────────────── */}
  <LogoStrip />

  <section class="mx-auto -mt-2 max-w-[1180px] px-6 pb-16 sm:px-10 sm:pb-20">
    <div class="relative overflow-hidden bg-ink px-6 py-10 text-center sm:px-12 sm:py-12">
      <div
        class="pointer-events-none absolute inset-0 opacity-[.08]"
        style="background-image:radial-gradient(circle at 15% 20%, var(--color-gold) 0, transparent 45%),radial-gradient(circle at 85% 80%, var(--color-gold) 0, transparent 45%);"
        aria-hidden="true"
      ></div>
      <div class="relative">
        <p class="font-display text-[clamp(1.25rem,3.2vw,1.75rem)] uppercase tracking-[.04em] text-dark-text">
          Tặng thiệp miễn phí &amp; giao hàng tận nơi
        </p>
        <p class="mt-3 text-[15px] text-dark-text-muted sm:text-base">
          {SITE.brand}
        </p>
        <p class="mt-1 text-[15px] text-dark-text-muted sm:text-base">
          Lựa chọn hoàn hảo cho <span class="font-medium text-dark-text">quà tặng doanh nghiệp</span>
        </p>

        <div class="mt-7 flex items-center justify-center">
          <a
            href={`tel:${PHONE_TEL}`}
            data-contact="hotline-banner"
            class="text-[15px] font-semibold text-gold underline decoration-gold/50 underline-offset-4 sm:text-base"
          >
            Hotline: {PHONE_DISPLAY}
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── Khối 3 — Hero slideshow (auto-play 5500ms) ────────────── */}
  <HeroSlideshow slides={slides} />

  {/* ── Khối 4 — Dải 4 ý tin cậy ───────────────────────────────── */}
  <section class="border-b border-hairline bg-paper">
    <div data-reveal-group class="mx-auto grid max-w-[1180px] grid-cols-1 gap-11 px-6 py-11 sm:grid-cols-2 sm:px-10 lg:grid-cols-4">
      {
        trustPoints.map((tp) => (
          <div data-reveal class="grid grid-cols-[34px_minmax(0,1fr)] items-start gap-[18px]">
            <svg viewBox="0 0 32 32" fill="none" stroke="#c9a15a" stroke-width="1" class="mt-0.5 h-8 w-8">
              {tp.circle && <circle cx="16" cy="13" r="8.5" />}
              <path d={tp.path} />
              <path d={tp.extra} />
            </svg>
            <div>
              <h3 class="font-display text-[23px] leading-[1.15] text-ink">{tp.title}</h3>
              <p class="mt-1 text-pretty text-[13px] leading-[1.7] text-text-faint">{tp.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* ── Khối 5 — Bảng giá 7 khách sạn + chip lọc ──────────────── */}
  <section id="catalogue" class="scroll-mt-16 mx-auto max-w-[1180px] px-6 py-16 sm:px-10 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div>
        <p class="label-gold">Bộ sưu tập 2026</p>
        <h2 class="mt-2 font-display text-[clamp(1.75rem,4.5vw,2.75rem)] leading-[1.08] text-ink">
          Bảng giá bánh trung thu 7 khách sạn 5 sao
        </h2>
        <p class="mt-2 text-sm text-text-faint">
          {TONG_SO_MAU} mẫu hộp, giá từ {dinhDangGia(GIA_MIN)} đến {dinhDangGia(GIA_MAX)}.
        </p>
      </div>
    </div>

    <div class="mt-8">
      <BangGiaTongHop rows={bangGiaRows} />
    </div>
  </section>

  {/* ── Khối 6 — Chọn theo ngân sách ───────────────────────────── */}
  <section id="ngan-sach" class="scroll-mt-16 bg-paper-warm py-16 md:py-24">
    <div class="mx-auto max-w-[1180px] px-6 sm:px-10">
      <p class="label-gold">Gợi ý nhanh</p>
      <h2 class="mt-2 font-display text-[clamp(1.5rem,4vw,2.375rem)] text-ink">Chọn theo ngân sách</h2>

      <div data-reveal-group class="mt-8 grid gap-6 md:grid-cols-3">
        {
          nhomDaDo.map((nhom) => (
            <div data-reveal class="border border-hairline bg-paper p-6">
              <h3 class="font-display text-[26px] text-ink">{nhom.nhan}</h3>
              <p class="mt-1 text-xs text-text-faint">{nhom.mo_ta}</p>
              <ul class="mt-5 space-y-2.5 text-sm">
                {nhom.san_pham.map(({ hotel, sp }) => (
                  <li class="flex items-baseline justify-between gap-3 border-b border-paper-warm pb-2.5 last:border-0">
                    <a href={duongDan(hotel.id)} title={sp.ten_hien_thi} class="min-w-0 truncate text-ink-soft hover:text-accent hover:underline">
                      {sp.ten_hien_thi}
                    </a>
                    <span class="price shrink-0 whitespace-nowrap">{dinhDangGia(sp.gia_da_vat)}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        {/* Thẻ VIP: nền ink, chữ paper + gold. KHÔNG liệt kê tên hộp/giá cụ thể. */}
        <div data-reveal class="bg-ink p-6">
          <p class="text-[11px] uppercase tracking-[.2em] text-gold">Đẳng cấp VIP</p>
          <h3 class="mt-2 font-display text-[28px] leading-tight text-dark-text">
            Dòng hộp thượng hạng kèm quà tặng cao cấp
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-dark-text-muted">
            Cho lãnh đạo & đối tác quan trọng — cấu hình tùy biến theo gu và ngân sách.
          </p>
          <a
            href="/hop-vip"
            class="mt-5 inline-block bg-gold px-5 py-3.5 text-sm font-medium uppercase tracking-wide text-ink hover:bg-paper"
          >
            Xem hộp VIP
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── Khối 7 — Doanh nghiệp (không chứa form) ───────────────── */}
  <section id="doanh-nghiep" class="scroll-mt-16 border-t border-b border-hairline py-14">
    <div class="mx-auto grid max-w-[1180px] gap-14 px-6 sm:px-10 lg:grid-cols-2 lg:items-center">
      {ANH_SMA[0] && (
        <div class="aspect-4/5 overflow-hidden lg:order-1">
          <Image
            src={ANH_SMA[0]}
            alt="Hộp bánh trung thu in logo doanh nghiệp — hộp vàng mộc lan"
            width={600}
            height={600}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      )}

      <div data-reveal class="lg:order-2">
        <p class="label-gold">Doanh nghiệp</p>
        <h2 class="mt-2 font-display text-[clamp(1.75rem,4vw,2.5rem)] text-ink">
          Hộp quà mang thương hiệu doanh nghiệp của bạn
        </h2>
        <ul class="mt-6 space-y-3.5 text-sm leading-[1.65] text-ink-soft">
          <li class="flex gap-3.5">
            <span aria-hidden="true" class="text-gold">—</span>
            Chiết khấu cực tốt theo số lượng, báo giá riêng theo từng mức ngân sách
          </li>
          <li class="flex gap-3.5">
            <span aria-hidden="true" class="text-gold">—</span>
            Thiết kế hộp riêng với logo và thiệp công ty
          </li>
          <li class="flex gap-3.5">
            <span aria-hidden="true" class="text-gold">—</span>
            Đa dạng lựa chọn với nhiều phân khúc, khách sạn hàng đầu
          </li>
          <li class="flex gap-3.5">
            <span aria-hidden="true" class="text-gold">—</span>
            Dễ dàng lựa chọn các thành phần bên trong hộp
          </li>
          <li class="flex gap-3.5">
            <span aria-hidden="true" class="text-gold">—</span>
            Hóa đơn, chứng từ đầy đủ
          </li>
        </ul>
      </div>
    </div>
  </section>

  {/* ── Khối 8 — Form báo giá B2B ──────────────────────────────── */}
  <section id="bao-gia-b2b" class="scroll-mt-16 py-16 md:py-24">
    <div class="mx-auto max-w-[1180px] px-6 sm:px-10">
      <FormB2B />
    </div>
  </section>

  {/* ── Khối 9 — FAQ (list tĩnh, luôn hiển thị) ───────────────── */}
  <section class="border-t border-hairline bg-paper-warm py-16 md:py-24">
    <div class="mx-auto grid max-w-[1180px] gap-14 px-6 sm:px-10 md:grid-cols-[.6fr_1.4fr]">
      <div>
        <p class="label-gold">Hỏi đáp</p>
        <h2 class="mt-2 font-display text-[clamp(1.5rem,4vw,2.375rem)] text-ink">Câu hỏi thường gặp</h2>
      </div>
      <div>
        {
          FAQ_CHUAN.map((item, i) => (
            <div class={`grid gap-8 border-t border-hairline py-6 sm:grid-cols-[1fr_1.3fr] ${i === FAQ_CHUAN.length - 1 ? 'border-b' : ''}`}>
              <p class="text-[15px] font-medium text-ink">{item.q}</p>
              <p class="text-sm leading-[1.75] text-text-muted">{item.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
