---
// Thanh CTA cố định dưới màn hình — CHỈ hiện trên mobile (80%+ traffic từ ads).
// Ngoài ra: 2 nút tròn nổi góc phải (gọi + Zalo) — hiện trên MỌI kích thước màn hình,
// đặt phía trên thanh CTA mobile để không chồng lấn.
import { SITE, PHONE_TEL } from '../config/site';
---

<div
  class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-2 border-t border-hairline bg-paper md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <a
    href={`tel:${PHONE_TEL}`}
    data-contact="hotline-floating"
    class="flex min-h-[44px] items-center justify-center gap-2 border-r border-hairline py-4 text-sm font-medium uppercase tracking-wide text-ink"
  >
    <svg
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"
      ></path>
    </svg>
    Gọi ngay
  </a>
  <a
    href={SITE.zalo}
    target="_blank"
    rel="noopener"
    data-contact="zalo-floating"
    class="flex min-h-[44px] items-center justify-center gap-2 bg-gold py-4 text-sm font-medium uppercase tracking-wide text-ink"
  >
    <svg class="h-5 w-5" viewBox="0 0 48 48" aria-hidden="true">
      <rect width="48" height="48" rx="10" fill="#0068FF" />
      <text x="24" y="30" text-anchor="middle" font-family="Arial, sans-serif" font-size="17" font-weight="700" fill="#fff">Zalo</text>
    </svg>
    Chat Zalo
  </a>
</div>

<div
  class="fixed right-4 z-50 flex flex-col gap-4 bottom-[calc(4.5rem+env(safe-area-inset-bottom))] md:bottom-6"
>
  <a
    href={SITE.zalo}
    target="_blank"
    rel="noopener"
    data-contact="zalo-floating-side"
    aria-label="Chat Zalo"
    class="group relative flex h-14 w-14 items-center justify-center"
  >
    <span class="absolute inset-0 animate-ping rounded-full bg-[#0068ff]/60" aria-hidden="true"></span>
    <span class="relative flex h-14 w-14 items-center justify-center rounded-full bg-[#0068ff] shadow-lg transition-transform group-hover:scale-105">
      <svg class="h-8 w-8" viewBox="0 0 48 48" aria-hidden="true">
        <text x="24" y="30" text-anchor="middle" font-family="Arial, sans-serif" font-size="17" font-weight="700" fill="#fff">Zalo</text>
      </svg>
    </span>
  </a>
  <a
    href={`tel:${PHONE_TEL}`}
    data-contact="hotline-floating-side"
    aria-label="Gọi ngay"
    class="group relative flex h-14 w-14 items-center justify-center"
  >
    <span class="absolute inset-0 animate-ping rounded-full bg-accent/60" aria-hidden="true"></span>
    <span class="relative flex h-14 w-14 items-center justify-center rounded-full bg-accent text-white shadow-lg transition-transform group-hover:scale-105">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"
        ></path>
      </svg>
    </span>
  </a>
</div>
