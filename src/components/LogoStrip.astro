---
// Dải logo thật 7 khách sạn — "Phân phối chính thức", đặt ngay dưới hero (chữ),
// trước hero slideshow. Logo do khách hàng cung cấp tại /logo (root repo).
import { KHACH_SAN } from '../lib/pricing';
import { layLogo } from '../lib/hotel-images';

const PLACEHOLDER_BG = 'repeating-linear-gradient(135deg,#ede8dd 0 8px,#f6f2e9 8px 16px)';
---

<section class="pb-12" data-reveal>
  <div class="mx-auto flex max-w-[1180px] items-center justify-center gap-3 px-6 pb-6 sm:px-10">
    <span class="h-px w-7 bg-gold" aria-hidden="true"></span>
    <p class="text-[11px] uppercase tracking-[.22em] text-text-faint">
      Phân phối chính thức · 7 khách sạn 5 sao
    </p>
    <span class="h-px w-7 bg-gold" aria-hidden="true"></span>
  </div>

  <div class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-center gap-x-10 gap-y-6 px-6 sm:px-10">
    {
      KHACH_SAN.map((ks) => {
        const logo = layLogo(ks.id);
        // Intercontinental.png có nhiều khoảng trắng thừa quanh logo (nguồn gốc file) —
        // phóng to hơn để bù trừ, giữ kích thước thị giác đồng đều với các logo khác.
        const heightClass = ks.id === 'intercontinental-lm72' ? 'h-20' : 'h-10';
        // Nikko.png là logo màu trắng (thiết kế cho nền tối) — đảo màu để hiện rõ trên nền kem sáng.
        const filterClass = ks.id === 'nikko' ? 'invert grayscale opacity-80' : 'grayscale opacity-80';
        return logo ? (
          <img src={logo} alt={`Logo ${ks.ten}`} class={`${heightClass} w-auto max-w-[140px] object-contain ${filterClass}`} loading="lazy" />
        ) : (
          <div
            class="flex h-10 w-[140px] items-center justify-center text-center text-[10px] uppercase tracking-wide text-ink-soft"
            style={{ background: PLACEHOLDER_BG }}
          >
            {ks.ten}
          </div>
        );
      })
    }
  </div>
</section>
