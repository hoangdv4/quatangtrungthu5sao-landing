---
// Dải logo thật 7 khách sạn — "Phân phối chính thức", đặt ngay dưới hero (chữ),
// trước hero slideshow. Logo do khách hàng cung cấp tại /logo (root repo).
import { KHACH_SAN } from '../lib/pricing';
import { layLogo } from '../lib/hotel-images';

const PLACEHOLDER_BG = 'repeating-linear-gradient(135deg,#ede8dd 0 8px,#f6f2e9 8px 16px)';
---

<section class="pb-12" data-reveal>
  <div class="mx-auto flex max-w-[1180px] items-center justify-center gap-3 px-6 pb-6 sm:px-10">
    <span class="h-px w-7 bg-gold" aria-hidden="true"></span>
    <p class="text-[11px] uppercase tracking-[.22em] text-text-faint">
      Phân phối chính thức · 7 khách sạn 5 sao
    </p>
    <span class="h-px w-7 bg-gold" aria-hidden="true"></span>
  </div>

  <div class="mx-auto max-w-[1180px] overflow-x-auto px-6 sm:px-10">
    <div class="flex w-max min-w-full flex-nowrap items-center justify-center gap-x-6 sm:gap-x-9">
      {
        KHACH_SAN.map((ks) => {
          const logo = layLogo(ks.id);
          // Mỗi file logo có tỷ lệ khung hình + khoảng trắng thừa quanh nội dung khác nhau
          // (nguồn gốc file) — chỉnh riêng height/max-width từng khách sạn để kích thước
          // thị giác (diện tích hiển thị) đồng đều nhau trên dải logo. Toàn bộ 7 logo phải
          // vừa 1 hàng không xuống dòng — max-width được thu nhỏ hơn so với thiết kế gốc.
          const sizeClass: Record<string, string> = {
            'intercontinental-lm72': 'h-16 max-w-[110px]',
            hilton: 'h-12 max-w-[110px]',
            renaissance: 'h-12 max-w-[120px]',
            sheraton: 'h-11 max-w-[100px]',
            sofitel: 'h-7 max-w-[150px]',
            nikko: 'h-9 max-w-[100px]',
          };
          const heightClass = sizeClass[ks.id] ?? 'h-8 max-w-[100px]';
          // Nikko.png là logo màu trắng (thiết kế cho nền tối) — đảo màu để hiện rõ trên nền kem sáng.
          const filterClass = ks.id === 'nikko' ? 'invert grayscale opacity-80' : 'grayscale opacity-80';
          return logo ? (
            <img src={logo} alt={`Logo ${ks.ten}`} class={`${heightClass} w-auto shrink-0 object-contain ${filterClass}`} loading="lazy" />
          ) : (
            <div
              class="flex h-10 w-[110px] shrink-0 items-center justify-center text-center text-[10px] uppercase tracking-wide text-ink-soft"
              style={{ background: PLACEHOLDER_BG }}
            >
              {ks.ten}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
