---
// Bảng giá dạng HTML chữ — TUYỆT ĐỐI không dùng ảnh chụp bảng (AI không đọc ảnh).
// ⚠️ C0: chỉ hiển thị ten_hien_thi (đã sanitize), KHÔNG ten_day_du.
import { dinhDangGia, type SanPham } from '../lib/pricing';

interface Props {
  sanPham: SanPham[];
}

const { sanPham } = Astro.props;
---

<div class="overflow-x-auto rounded-xl ring-1 ring-son-100">
  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
    <thead>
      <tr class="bg-son-50 text-slate-900">
        <th scope="col" class="px-4 py-3 font-semibold">STT</th>
        <th scope="col" class="px-4 py-3 font-semibold">Tên hộp</th>
        <th scope="col" class="px-4 py-3 font-semibold">Quy cách</th>
        <th scope="col" class="px-4 py-3 text-right font-semibold">Giá đã VAT</th>
      </tr>
    </thead>
    <tbody>
      {
        sanPham.map((sp) => (
          <tr class="border-t border-son-100 odd:bg-white even:bg-son-50/40">
            <td class="px-4 py-3 text-slate-600">{sp.stt}</td>
            <td class="px-4 py-3 font-medium text-slate-900">{sp.ten_hien_thi}</td>
            <td class="px-4 py-3 text-slate-700">{sp.quy_cach}</td>
            <td class="px-4 py-3 text-right font-semibold text-son-700">
              {dinhDangGia(sp.gia_da_vat)}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
