---
// Bảng giá dạng thẻ có ảnh — thay bảng dạng dòng ở trang chi tiết bộ sưu tập.
// Số cột lưới co theo số mẫu hộp (không dùng auto-fit — để lại ô lẻ ở hàng cuối).
// ⚠️ C0: chỉ hiển thị ten_hien_thi (đã sanitize), KHÔNG ten_day_du.
import { Image } from 'astro:assets';
import { dinhDangGia, type SanPham } from '../lib/pricing';
import { layAnhSku } from '../lib/hotel-images';
import { SITE } from '../config/site';

interface Props {
  hotelId: string;
  sanPham: SanPham[];
}

const { hotelId, sanPham } = Astro.props;
const n = sanPham.length;

const cols = n <= 2 ? 2 : n === 3 ? 3 : n <= 4 ? 2 : n <= 6 ? 3 : 4;
const imgH = n <= 2 ? '400px' : n === 3 ? '300px' : n <= 4 ? '340px' : n <= 6 ? '280px' : '230px';

const PLACEHOLDER_BG = 'repeating-linear-gradient(135deg,#ede8dd 0 8px,#f6f2e9 8px 16px)';
---

<div
  class="grid grid-cols-1 gap-x-[26px] gap-y-8 sm:grid-cols-2"
  style={{ '--cols': cols }}
  data-card-grid
>
  {
    sanPham.map((sp) => {
      const anh = layAnhSku(hotelId, sp.stt);
      return (
        <div class="flex flex-col gap-3.5">
          {anh ? (
            <Image
              src={anh}
              alt={sp.ten_hien_thi}
              width={600}
              height={600}
              loading="lazy"
              style={{ height: imgH }}
              class="w-full object-cover"
            />
          ) : (
            <div
              class="flex w-full items-end justify-end p-3.5"
              style={{ height: imgH, background: PLACEHOLDER_BG }}
              aria-hidden="true"
            >
              <span class="text-[11px] uppercase tracking-[.13em] text-text-faint">Ảnh hộp</span>
            </div>
          )}
          <p class="font-display text-[21px] leading-tight text-ink">{sp.ten_hien_thi}</p>
          <p class="text-xs leading-relaxed text-text-faint">{sp.quy_cach}</p>
          <div class="flex items-baseline justify-between gap-3 border-t border-hairline pt-[9px]">
            <span class="price whitespace-nowrap text-[17px]">{dinhDangGia(sp.gia_da_vat)}</span>
            <a
              href={SITE.zalo}
              target="_blank"
              rel="noopener"
              data-contact={`zalo-sku-${sp.stt}`}
              class="whitespace-nowrap border-b border-gold pb-0.5 text-[11px] tracking-[.05em] text-accent hover:text-accent-hover"
            >
              Đặt hộp này
            </a>
          </div>
        </div>
      );
    })
  }
</div>

<style define:vars={{ cols }}>
  @media (min-width: 1024px) {
    [data-card-grid] {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
  }
</style>
