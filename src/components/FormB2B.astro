---
// Khối 5 — form B2B. POST JSON tới PUBLIC_FORM_ENDPOINT (Google Apps Script).
// Apps Script không trả CORS header → dùng mode:'no-cors', hiển thị success
// phía client sau khi gửi, KHÔNG redirect.
import { KHACH_SAN, duongDan } from '../lib/pricing';
import { SITE, PHONE_TEL, PHONE_DISPLAY } from '../config/site';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT?.trim() ?? '';

const nganSach = ['Dưới 1,1tr', '1,2–2,6tr', '2,6–4tr', 'Trên 4tr'];
const soLuong = ['30–50', '50–150', '150+'];

// Bảng tra cứu "báo giá ước tính" — build-time từ KHACH_SAN thật (giữ 1 source of truth),
// client JS chỉ đọc để hiển thị khoảng giá phù hợp theo lựa chọn, không tự tính giá song song.
const uocTinh = KHACH_SAN.map((ks) => ({
  id: ks.id,
  ten: ks.ten,
  gia_tu: ks.gia_tu,
  gia_den: ks.gia_den,
  url: duongDan(ks.id),
}));
---

<div class="grid border border-hairline lg:grid-cols-[340px_minmax(0,1fr)]">
  <div class="flex flex-col justify-between border-b border-hairline bg-paper-warm p-7 sm:p-9 lg:border-b-0 lg:border-r">
    <div>
      <p class="label-gold">Báo giá trong 30 phút</p>
      <h3 class="mt-2 font-display text-[34px] leading-tight text-ink">
        Gửi yêu cầu, nhận bảng giá riêng theo số lượng
      </h3>
      <p class="mt-3 text-sm leading-relaxed text-text-muted">
        Điền thông tin bên cạnh hoặc liên hệ trực tiếp, chúng tôi sẽ phản hồi trong 30 phút.
      </p>
    </div>
    <div class="mt-6 flex flex-col gap-3">
      <a
        href={SITE.zalo}
        target="_blank"
        rel="noopener"
        data-contact="zalo"
        class="inline-flex min-h-[44px] items-center justify-center bg-ink px-6 text-sm font-medium uppercase tracking-wide text-paper hover:bg-accent"
      >
        Chat Zalo {PHONE_DISPLAY}
      </a>
      <a
        href={`tel:${PHONE_TEL}`}
        data-contact="hotline"
        class="inline-flex min-h-[44px] items-center justify-center border border-hairline-input px-6 text-sm font-medium uppercase tracking-wide text-ink hover:bg-paper"
      >
        Gọi hotline
      </a>
    </div>
  </div>

  <form
    id="form-b2b"
    data-endpoint={endpoint}
    class="grid gap-6 p-5 sm:p-8"
    novalidate
  >
    <div class="grid gap-5 sm:grid-cols-3">
      <label class="block">
        <span class="label-muted">Tên *</span>
        <input
          type="text"
          name="ten"
          required
          autocomplete="name"
          class="mt-1 w-full border-0 border-b border-hairline-input bg-transparent px-0 py-2 text-base text-ink focus:border-accent focus:outline-none focus:ring-0"
        />
      </label>
      <label class="block">
        <span class="label-muted">SĐT *</span>
        <input
          type="tel"
          name="sdt"
          required
          inputmode="tel"
          autocomplete="tel"
          pattern="[0-9+\s().-]{9,15}"
          class="mt-1 w-full border-0 border-b border-hairline-input bg-transparent px-0 py-2 text-base text-ink focus:border-accent focus:outline-none focus:ring-0"
        />
      </label>
      <label class="block">
        <span class="label-muted">Công ty *</span>
        <input
          type="text"
          name="cong_ty"
          required
          autocomplete="organization"
          class="mt-1 w-full border-0 border-b border-hairline-input bg-transparent px-0 py-2 text-base text-ink focus:border-accent focus:outline-none focus:ring-0"
        />
      </label>
    </div>

    <fieldset>
      <legend class="label-muted">Ngân sách/suất</legend>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          nganSach.map((v, i) => (
            <label class="cursor-pointer inline-flex min-h-[44px] items-center border border-hairline-strong px-3.5 text-sm text-ink-soft has-checked:border-ink has-checked:bg-ink has-checked:text-paper has-checked:font-medium">
              <input type="radio" name="ngan_sach" value={v} checked={i === 0} class="sr-only" />
              {v}
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset>
      <legend class="label-muted">Số lượng (hộp)</legend>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          soLuong.map((v, i) => (
            <label class="cursor-pointer inline-flex min-h-[44px] items-center border border-hairline-strong px-3.5 text-sm text-ink-soft has-checked:border-ink has-checked:bg-ink has-checked:text-paper has-checked:font-medium">
              <input type="radio" name="so_luong" value={v} checked={i === 0} class="sr-only" />
              {v}
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="grid gap-5 sm:grid-cols-2">
      <label class="block">
        <span class="label-muted">Khách sạn quan tâm</span>
        <select
          name="khach_san_quan_tam"
          class="mt-1 w-full border-0 border-b border-hairline-input bg-transparent px-0 py-2 text-base text-ink focus:border-accent focus:outline-none focus:ring-0"
        >
          <option value="">Chưa rõ / tư vấn giúp tôi</option>
          {KHACH_SAN.map((ks) => <option value={ks.ten}>{ks.ten}</option>)}
        </select>
      </label>

      <fieldset>
        <legend class="label-muted">Cần in logo công ty?</legend>
        <div class="mt-3 flex gap-2">
          {
            ['Có', 'Chưa cần'].map((v, i) => (
              <label class="cursor-pointer inline-flex min-h-[44px] items-center border border-hairline-strong px-3.5 text-sm text-ink-soft has-checked:border-ink has-checked:bg-ink has-checked:text-paper has-checked:font-medium">
                <input type="radio" name="can_in_logo" value={v} checked={i === 1} class="sr-only" />
                {v}
              </label>
            ))
          }
        </div>
      </fieldset>
    </div>

    <p id="form-uoc-tinh" class="border border-hairline bg-paper-warm px-4 py-3 text-sm text-ink-soft"></p>

    <input type="hidden" name="utm_source" value="" />
    <input type="hidden" name="utm_campaign" value="" />
    <input type="hidden" name="trang" value="" />

    <script type="application/json" id="form-uoc-tinh-data" set:html={JSON.stringify(uocTinh)} />

    <div class="flex flex-wrap items-center justify-between gap-4">
      <button
        type="submit"
        class="bg-accent px-6 py-3 text-sm font-medium uppercase tracking-wide text-paper hover:bg-accent-hover disabled:opacity-60"
      >
        Nhận báo giá trong 30 phút
      </button>
      <p class="text-xs text-text-faint">Không spam. Thông tin chỉ dùng để báo giá.</p>
    </div>

    <p
      id="form-msg"
      role="status"
      aria-live="polite"
      class="hidden px-4 py-3 text-sm"
    >
    </p>
  </form>
</div>

<script is:inline>
  (function () {
    var form = document.getElementById('form-b2b');
    if (!form) return;
    var msg = document.getElementById('form-msg');
    var btn = form.querySelector('button[type="submit"]');

    // UTM đọc từ URL, đổ vào hidden field.
    var qs = new URLSearchParams(location.search);
    form.utm_source.value = qs.get('utm_source') || '';
    form.utm_campaign.value = qs.get('utm_campaign') || '';
    form.trang.value = location.pathname;

    // Báo giá ước tính — đọc bảng tra cứu build-time (không tính giá độc lập phía client).
    var uocTinhEl = document.getElementById('form-uoc-tinh');
    var uocTinhDataEl = document.getElementById('form-uoc-tinh-data');
    var uocTinhData = uocTinhDataEl ? JSON.parse(uocTinhDataEl.textContent || '[]') : [];

    function formatGia(n) {
      return new Intl.NumberFormat('vi-VN').format(n) + 'đ';
    }

    function capNhatUocTinh() {
      if (!uocTinhEl) return;
      var ksTen = form.khach_san_quan_tam ? form.khach_san_quan_tam.value : '';
      var phuHop = ksTen ? uocTinhData.filter(function (ks) { return ks.ten === ksTen; }) : uocTinhData;
      if (phuHop.length === 0) {
        uocTinhEl.textContent = '';
        return;
      }
      var minGia = Math.min.apply(null, phuHop.map(function (ks) { return ks.gia_tu; }));
      var maxGia = Math.max.apply(null, phuHop.map(function (ks) { return ks.gia_den; }));
      var soKs = phuHop.length;
      uocTinhEl.textContent = ksTen
        ? 'Báo giá ước tính ' + ksTen + ': ' + formatGia(minGia) + ' – ' + formatGia(maxGia) + '/hộp (đã VAT). Số liệu chính xác theo số lượng sẽ được tư vấn qua Zalo.'
        : 'Báo giá ước tính trên ' + soKs + ' khách sạn: ' + formatGia(minGia) + ' – ' + formatGia(maxGia) + '/hộp (đã VAT). Chọn khách sạn quan tâm để thu hẹp khoảng giá.';
    }

    if (form.khach_san_quan_tam) {
      form.khach_san_quan_tam.addEventListener('change', capNhatUocTinh);
    }
    capNhatUocTinh();

    function show(text, ok) {
      msg.textContent = text;
      msg.className =
        'border px-4 py-3 text-sm ' +
        (ok ? 'border-hairline text-ink' : 'border-status-low-stock text-status-low-stock');
    }

    // Chống gửi trùng: trước đây btn.disabled trong lúc await vô tình đóng vai
    // này, nay không await nữa nên phải khoá tường minh trong 5s.
    var dangGui = false;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (dangGui) return;
      if (!form.checkValidity()) {
        show('Vui lòng điền đầy đủ Tên, SĐT và Công ty.', false);
        return;
      }
      var endpoint = form.dataset.endpoint;
      if (!endpoint) {
        show('Form chưa được cấu hình. Vui lòng liên hệ qua Zalo hoặc hotline.', false);
        return;
      }

      dangGui = true;
      btn.disabled = true;
      var data = Object.fromEntries(new FormData(form).entries());

      // KHÔNG await: Apps Script trả 302 rồi mới xử lý, browser đi theo redirect
      // nên await mất 10–15s — người dùng tưởng treo và bấm gửi nhiều lần.
      // Với mode:'no-cors' response vốn không đọc được, nên chờ cũng chẳng biết
      // thành công hay thất bại → chờ là vô nghĩa. keepalive giữ request sống
      // kể cả khi người dùng rời trang ngay sau khi bấm.
      fetch(endpoint, {
        method: 'POST',
        mode: 'no-cors',
        keepalive: true,
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(data),
      }).catch(function () {
        /* no-cors không cho đọc lỗi thật; im lặng để không báo sai cho người dùng */
      });

      show('Đã nhận yêu cầu. Chúng tôi sẽ gọi lại trong 30 phút.', true);
      form.reset();
      if (window.track) window.track('Lead', { content_category: 'b2b' });

      // Mở lại sau 5s: đủ để tránh bấm trùng, vẫn cho khách gửi yêu cầu thứ hai
      // (ví dụ hỏi thêm khách sạn khác) mà không phải tải lại trang.
      setTimeout(function () {
        dangGui = false;
        btn.disabled = false;
      }, 5000);
    });
  })();
</script>
