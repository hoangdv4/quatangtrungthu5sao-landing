---
// Khối "Cùng tầm giá — còn hàng".
// Hiện trong hai tình huống:
//   1. Khách sạn còn bán nhưng mẫu đã hết RẺ HƠN mẫu rẻ nhất còn hàng — có một
//      khoảng giá khách đang nhắm mà trang này không phục vụ được nữa.
//   2. Khách sạn tạm hết hàng TOÀN BỘ — không còn gì để bán, nên gợi ý phủ cả
//      dải giá của khách sạn thay vì chỉ một mức. Đây là lúc khách cần lối đi
//      tiếp nhất, tuyệt đối không được tắt khối này.
// Tự tắt khi mọi mẫu đều còn hàng; không cần cấu hình riêng cho từng khách sạn.
import { Image } from 'astro:assets';
import { KHACH_SAN, conHang, hetHangToanBo, dinhDangGia, duongDan, type KhachSan, type SanPham } from '../lib/pricing';
import { anhKhachSan } from '../lib/hotel-images';

interface Props {
  ks: KhachSan;
}

const { ks } = Astro.props;

const daHet = ks.san_pham.filter((sp) => !conHang(sp));
const conHangKS = ks.san_pham.filter(conHang);
const hetSach = hetHangToanBo(ks);

// Mẫu rẻ nhất / đắt nhất khách sạn này vẫn bán được — dải giá trang còn phục vụ.
const giaReNhatConHang = conHangKS.length ? Math.min(...conHangKS.map((sp) => sp.gia_da_vat)) : 0;
const giaDatNhatConHang = conHangKS.length ? Math.max(...conHangKS.map((sp) => sp.gia_da_vat)) : 0;

// Mẫu đã hết nằm NGOÀI dải còn bán — khách nhắm mức đó thì trang này không còn gì đưa ra.
// Xét cả hai đầu: cuối mùa hay gặp cảnh chỉ còn đúng hộp phổ thông, mất sạch dải VIP phía trên
// (Meliá), chứ không chỉ mất đầu rẻ.
const hetNgoaiDai = hetSach
  ? daHet
  : daHet.filter((sp) => sp.gia_da_vat < giaReNhatConHang || sp.gia_da_vat > giaDatNhatConHang);

// Mức giá khách đang nhắm nhưng trang này không còn phục vụ được — mốc để xếp gợi ý.
const giaHut = hetNgoaiDai.length ? Math.min(...hetNgoaiDai.map((sp) => sp.gia_da_vat)) : 0;

// Hết sạch: mọi mức giá đều hụt, không có trần để lọc. Mất đầu rẻ: gợi ý không đắt hơn
// mẫu rẻ nhất còn bán. Chỉ mất dải trên: bỏ trần, nếu không sẽ không còn ứng viên nào.
const chiHutDauTren =
  !hetSach && hetNgoaiDai.length > 0 && hetNgoaiDai.every((sp) => sp.gia_da_vat > giaDatNhatConHang);
const tranGia = hetSach || chiHutDauTren ? Infinity : giaReNhatConHang;
const coKhoangHut = hetSach || (hetNgoaiDai.length > 0 && conHangKS.length > 0);

const gan = (gia: number) => Math.abs(gia - giaHut);

// Mỗi khách sạn khác chỉ góp 1 hộp — hộp còn hàng gần mức giá đang hụt nhất.
const ungVien: { k: KhachSan; sp: SanPham }[] = [];
if (coKhoangHut) {
  for (const k of KHACH_SAN) {
    if (k.id === ks.id) continue;
    const hop = k.san_pham
      .filter(conHang)
      .filter((sp) => sp.gia_da_vat <= tranGia)
      .sort((a, b) => gan(a.gia_da_vat) - gan(b.gia_da_vat))[0];
    if (hop) ungVien.push({ k, sp: hop });
  }
  // Cùng thành phố lên trước: khách Sài Gòn nhận hàng trong 24–48h, còn hộp Hà Nội
  // phải ship 2–4 ngày — gợi ý khác vùng chỉ dùng để lấp chỗ khi thiếu.
  ungVien.sort((a, b) => {
    const cungTp = (x: KhachSan) => (x.thanh_pho === ks.thanh_pho ? 0 : 1);
    return cungTp(a.k) - cungTp(b.k) || gan(a.sp.gia_da_vat) - gan(b.sp.gia_da_vat);
  });
  ungVien.length = Math.min(ungVien.length, 3);
}

const PLACEHOLDER_BG = 'repeating-linear-gradient(135deg,#ede8dd 0 7px,#f6f2e9 7px 14px)';
---

{
  ungVien.length > 0 && (
    <div data-reveal class="mt-14 border-t border-hairline pt-14">
      <p class="text-[11px] uppercase tracking-[.22em] text-accent">Gợi ý thay thế</p>
      <h2 class="mt-2 font-display text-[32px] leading-[1.1] text-ink">Cùng tầm giá — còn hàng</h2>
      <p class="mt-3 max-w-[62ch] text-[15px] leading-[1.7] text-[#4a453d]">
        {hetSach ? (
          <>
            Toàn bộ {daHet.length} mẫu {ks.ten} hiện tạm hết hàng. Dưới đây là các hộp còn hàng của
            khách sạn 5 sao khác cùng tầm giá — hoặc nhắn Zalo để được báo khi {ks.ten} có hàng lại.
          </>
        ) : (
          <>
            {hetNgoaiDai.length} mẫu {ks.ten} tầm {dinhDangGia(giaHut)} hiện tạm hết hàng. Nếu anh/chị
            muốn giữ đúng tầm giá này, dưới đây là các hộp còn hàng của khách sạn 5 sao khác cùng phân khúc.
          </>
        )}
      </p>

      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        {ungVien.map(({ k, sp }) => {
          const anh = anhKhachSan(k.id)[0];
          return (
            <a href={duongDan(k.id)} class="block">
              {anh ? (
                <Image
                  src={anh}
                  alt={`Bánh trung thu ${k.ten} 2026`}
                  width={600}
                  height={400}
                  loading="lazy"
                  class="h-[200px] w-full object-cover"
                />
              ) : (
                <div class="h-[200px] w-full" style={{ background: PLACEHOLDER_BG }} aria-hidden="true" />
              )}
              <p class="mt-3 font-display text-[22px] text-ink">{k.ten}</p>
              <p class="mt-1 text-[13px] leading-[1.5] text-ink-soft">{sp.ten_hien_thi}</p>
              <p class="price mt-1 text-[15px] text-ink">{dinhDangGia(sp.gia_da_vat)}</p>
            </a>
          );
        })}
      </div>
    </div>
  )
}
