---
// Khối 1.5 — Bảng giá 7 khách sạn (trang chủ) + 4 chip lọc theo tier giá + thanh trượt khoảng giá.
// Bảng HTML chữ thật (AI/crawler đọc được) — thay cho card-grid ảnh trước đây.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { duongDan, khoangGia, dinhDangGia, GIA_MIN, GIA_MAX, type KhachSan, type Tier } from '../lib/pricing';

interface Row {
  ks: KhachSan;
  anh: ImageMetadata | undefined;
  tiers: Tier[];
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;

const FILTERS: { id: 'all' | Tier; label: string }[] = [
  { id: 'all', label: 'Tất cả' },
  { id: 'low', label: 'Dưới 1,1tr' },
  { id: 'mid', label: '1,2–2,6tr' },
  { id: 'vip', label: 'Trên 2,6tr' },
];

const PLACEHOLDER_BG = 'repeating-linear-gradient(135deg,#ede8dd 0 6px,#f6f2e9 6px 12px)';
---

<div>
  <div class="mb-6 flex flex-wrap items-start justify-between gap-6">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Lọc theo mức giá">
      {
        FILTERS.map((f, i) => (
          <button
            type="button"
            data-tier-chip={f.id}
            class={`px-4 py-2.5 text-xs border ${
              i === 0 ? 'bg-ink text-paper border-ink' : 'bg-transparent text-ink-soft border-hairline-strong'
            }`}
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <div class="flex min-w-[240px] flex-1 flex-col gap-2 sm:max-w-[320px]">
      <label class="label-muted flex items-center justify-between text-[10px]">
        <span>Khoảng giá</span>
        <span><span data-gia-min-value>{dinhDangGia(GIA_MIN)}</span> – <span data-gia-max-value>{dinhDangGia(GIA_MAX)}</span></span>
      </label>
      <div class="relative h-4">
        <div class="pointer-events-none absolute top-1/2 h-1 w-full -translate-y-1/2 bg-hairline-strong"></div>
        <div data-gia-track class="pointer-events-none absolute top-1/2 h-1 -translate-y-1/2 bg-accent"></div>
        <input
          type="range"
          min={GIA_MIN}
          max={GIA_MAX}
          step="1000"
          value={GIA_MIN}
          data-gia-slider-min
          aria-label="Mức giá thấp nhất"
          class="range-thumb pointer-events-none absolute inset-x-0 top-1/2 h-1 w-full -translate-y-1/2 appearance-none bg-transparent"
        />
        <input
          type="range"
          min={GIA_MIN}
          max={GIA_MAX}
          step="1000"
          value={GIA_MAX}
          data-gia-slider-max
          aria-label="Mức giá cao nhất"
          class="range-thumb pointer-events-none absolute inset-x-0 top-1/2 h-1 w-full -translate-y-1/2 appearance-none bg-transparent"
        />
      </div>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[640px] border-collapse text-left text-sm">
      <thead>
        <tr class="border-t border-b border-ink">
          <th scope="col" class="w-[88px] px-2 py-3"><span class="sr-only">Ảnh</span></th>
          <th scope="col" class="px-3 py-3 text-[10px] font-medium uppercase tracking-[.14em] text-text-faint">Khách sạn</th>
          <th scope="col" class="px-3 py-3 text-[10px] font-medium uppercase tracking-[.14em] text-text-faint">Khoảng giá *</th>
          <th scope="col" class="px-3 py-3 text-[10px] font-medium uppercase tracking-[.14em] text-text-faint">Mẫu · HSD</th>
          <th scope="col" class="px-3 py-3 text-[10px] font-medium uppercase tracking-[.14em] text-text-faint"><span class="sr-only">Liên kết</span></th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map(({ ks, anh, tiers }) => (
            <tr
              data-tier-row
              data-tiers={tiers.join(',')}
              data-gia-list={ks.san_pham.map((sp) => sp.gia_da_vat).join(',')}
              class="border-b border-hairline hover:bg-paper-warm"
            >
              <td class="px-2 py-4">
                {anh ? (
                  <Image src={anh} alt={`Bánh trung thu ${ks.ten} 2026`} width={88} height={66} loading="lazy" class="h-[66px] w-[88px] object-cover" />
                ) : (
                  <div class="h-[66px] w-[88px]" style={{ background: PLACEHOLDER_BG }} aria-hidden="true" />
                )}
              </td>
              <td class="px-3 py-4 font-display text-2xl leading-tight text-ink">{ks.ten}</td>
              <td class="price px-3 py-4">{khoangGia(ks)}</td>
              <td class="px-3 py-4 text-xs text-text-faint">
                <span data-mau-count>{ks.san_pham.length}/{ks.san_pham.length}</span> mẫu · HSD {ks.hsd_ngay} ngày
              </td>
              <td class="px-3 py-4 text-right">
                <a href={duongDan(ks.id)} class="border-b border-hairline-strong text-xs text-accent hover:text-accent-hover">
                  Xem chi tiết
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="mt-4 text-xs text-text-faint">* Giá niêm yết đã bao gồm VAT.</p>
</div>

<style>
  .range-thumb::-webkit-slider-thumb {
    pointer-events: auto;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 0;
    background: var(--color-accent);
    border: 2px solid var(--color-paper);
    box-shadow: 0 0 0 1px var(--color-accent);
    cursor: pointer;
  }
  .range-thumb::-moz-range-thumb {
    pointer-events: auto;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 0;
    background: var(--color-accent);
    border: 2px solid var(--color-paper);
    box-shadow: 0 0 0 1px var(--color-accent);
    cursor: pointer;
  }
</style>

<script>
  let tierDangChon = 'all';
  let giaMin = 0;
  let giaMax = Infinity;

  function apDungLoc() {
    document.querySelectorAll<HTMLElement>('[data-tier-row]').forEach((row) => {
      const tiers = (row.dataset.tiers || '').split(',');
      const khopTier = tierDangChon === 'all' || tiers.includes(tierDangChon);
      const giaList = (row.dataset.giaList || '')
        .split(',')
        .filter(Boolean)
        .map(Number);
      const soMauPhuHop = giaList.filter((g) => g >= giaMin && g <= giaMax).length;

      row.hidden = !khopTier || soMauPhuHop === 0;

      const countEl = row.querySelector<HTMLElement>('[data-mau-count]');
      if (countEl) countEl.textContent = `${soMauPhuHop}/${giaList.length}`;
    });
  }

  document.querySelectorAll<HTMLElement>('[data-tier-chip]').forEach((chip) => {
    chip.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('[data-tier-chip]').forEach((c) => {
        c.classList.remove('bg-ink', 'text-paper', 'border-ink');
        c.classList.add('bg-transparent', 'text-ink-soft', 'border-hairline-strong');
      });
      chip.classList.remove('bg-transparent', 'text-ink-soft', 'border-hairline-strong');
      chip.classList.add('bg-ink', 'text-paper', 'border-ink');

      tierDangChon = chip.dataset.tierChip ?? 'all';
      apDungLoc();
    });
  });

  const sliderMin = document.querySelector<HTMLInputElement>('[data-gia-slider-min]');
  const sliderMax = document.querySelector<HTMLInputElement>('[data-gia-slider-max]');
  const track = document.querySelector<HTMLElement>('[data-gia-track]');
  const labelMin = document.querySelector<HTMLElement>('[data-gia-min-value]');
  const labelMax = document.querySelector<HTMLElement>('[data-gia-max-value]');
  const dinhDang = (n: number) => n.toLocaleString('vi-VN') + 'đ';

  function capNhatTrack() {
    if (!sliderMin || !sliderMax || !track) return;
    const min = Number(sliderMin.min);
    const max = Number(sliderMin.max);
    const vMin = Number(sliderMin.value);
    const vMax = Number(sliderMax.value);
    const pctMin = ((vMin - min) / (max - min)) * 100;
    const pctMax = ((vMax - min) / (max - min)) * 100;
    track.style.left = `${pctMin}%`;
    track.style.width = `${pctMax - pctMin}%`;
  }

  function xuLySlider() {
    if (!sliderMin || !sliderMax) return;
    let vMin = Number(sliderMin.value);
    let vMax = Number(sliderMax.value);

    if (vMin > vMax) {
      [vMin, vMax] = [vMax, vMin];
      sliderMin.value = String(vMin);
      sliderMax.value = String(vMax);
    }

    giaMin = vMin;
    giaMax = vMax;
    if (labelMin) labelMin.textContent = dinhDang(vMin);
    if (labelMax) labelMax.textContent = dinhDang(vMax);
    capNhatTrack();
    apDungLoc();
  }

  sliderMin?.addEventListener('input', xuLySlider);
  sliderMax?.addEventListener('input', xuLySlider);

  if (sliderMin && sliderMax) {
    giaMin = Number(sliderMin.value);
    giaMax = Number(sliderMax.value);
  }
  capNhatTrack();
</script>
