---
import { SITE, PHONE_TEL, PHONE_DISPLAY } from '../config/site';
---

<header class="sticky top-0 z-40 border-b border-gold-soft/60 bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
    <a href="/" class="font-display text-lg leading-tight text-ink sm:text-xl">
      {SITE.brand}
    </a>

    <div class="flex items-center gap-2">
      <a
        href={`tel:${PHONE_TEL}`}
        data-contact="hotline"
        class="hidden border border-ink px-3 py-2 text-sm font-medium tracking-wide text-ink hover:bg-ink hover:text-paper sm:inline-block"
      >
        {PHONE_DISPLAY}
      </a>
      <a
        href={SITE.zalo}
        target="_blank"
        rel="noopener"
        data-contact="zalo"
        class="inline-flex min-h-[44px] items-center bg-ink px-4 text-sm font-medium uppercase tracking-wide text-paper hover:bg-gold"
      >
        Chat Zalo
      </a>
    </div>
  </div>
</header>
