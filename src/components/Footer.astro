---
// Khối 7 — Footer. Nội dung phải nhất quán 100% với fanpage/Zalo OA/GBP (GEO).
import { SITE, PHONE_TEL, PHONE_DISPLAY } from '../config/site';
import { KHACH_SAN, duongDan } from '../lib/pricing';
---

<footer class="mt-16 bg-ink text-paper/80">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2">
      <div>
        <p class="font-display text-xl text-paper">{SITE.brand}</p>
        <p class="label-gold-dark mt-2">Đại lý phân phối chính thức</p>
        <p class="mt-4 text-sm">
          Hotline/Zalo:
          <a href={`tel:${PHONE_TEL}`} data-contact="hotline" class="font-medium text-paper underline decoration-gold-soft underline-offset-4"
            >{PHONE_DISPLAY}</a
          >
        </p>
        <p class="mt-1 text-sm">{SITE.area}</p>
        {
          SITE.email && (
            <p class="mt-1 text-sm">
              Email: <a href={`mailto:${SITE.email}`} class="underline decoration-gold-soft underline-offset-4">{SITE.email}</a>
            </p>
          )
        }
      </div>

      <nav aria-label="Bảng giá theo khách sạn">
        <p class="label-gold-dark">Bảng giá theo khách sạn</p>
        <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
          {
            KHACH_SAN.map((ks) => (
              <li>
                <a href={duongDan(ks.id)} class="hover:text-gold-soft hover:underline">
                  {ks.ten}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/tim-hop-qua" class="hover:text-gold-soft hover:underline">
              Tìm hộp quà phù hợp
            </a>
          </li>
          <li>
            <a href="/so-sanh" class="hover:text-gold-soft hover:underline">
              So sánh 7 khách sạn
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <hr class="mt-10 border-t border-paper/15" />
    <p class="mt-6 text-xs text-paper/60">
      © 2026 {SITE.brand}. Giá niêm yết đã gồm VAT.
    </p>
  </div>
</footer>
