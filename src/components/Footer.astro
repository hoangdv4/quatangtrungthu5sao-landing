---
// Khối 10 — Footer. Nội dung phải nhất quán 100% với fanpage/Zalo OA/GBP (GEO).
import { SITE, PHONE_TEL, PHONE_DISPLAY } from '../config/site';
import { KHACH_SAN, duongDan } from '../lib/pricing';
---

<footer class="mt-16 bg-ink text-dark-text">
  <div class="mx-auto max-w-[1180px] px-6 pb-7 pt-14 sm:px-10">
    <div class="grid gap-10 md:grid-cols-[1fr_1.5fr_.9fr] md:gap-12">
      <div>
        <p class="font-display text-xl uppercase tracking-[.1em] text-dark-text">{SITE.brand}</p>
        <p class="label-gold-dark mt-2">Đại lý phân phối chính thức</p>
        <p class="mt-4 text-sm">
          Hotline:{' '}
          <a href={`tel:${PHONE_TEL}`} data-contact="hotline" class="font-medium text-dark-text underline decoration-gold underline-offset-4"
            >{PHONE_DISPLAY}</a
          >
        </p>
        <p class="mt-2 text-sm">
          Zalo:{' '}
          <a href={SITE.zalo} target="_blank" rel="noopener" data-contact="zalo" class="font-medium text-dark-text underline decoration-gold underline-offset-4"
            >Chat Zalo</a
          >
        </p>
        <p class="mt-4 max-w-[38ch] text-sm leading-relaxed text-dark-text-muted">{SITE.area}</p>
      </div>

      <nav aria-label="Bảng giá theo khách sạn">
        <p class="text-[11px] uppercase tracking-[.16em] text-text-faint">Bảng giá theo khách sạn</p>
        <ul class="mt-3 grid grid-cols-2 gap-x-5 gap-y-2 text-sm">
          {
            KHACH_SAN.map((ks) => (
              <li>
                <a href={duongDan(ks.id)} class="hover:text-gold hover:underline">
                  {ks.ten}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Công cụ">
        <p class="text-[11px] uppercase tracking-[.16em] text-text-faint">Công cụ</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href="/tim-hop-qua" class="hover:text-gold hover:underline">Tìm hộp quà phù hợp</a>
          </li>
          <li>
            <a href="/so-sanh" class="hover:text-gold hover:underline">So sánh 7 khách sạn</a>
          </li>
          <li>
            <a href="/#bao-gia-b2b" class="hover:text-gold hover:underline">Yêu cầu báo giá doanh nghiệp</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="mx-auto max-w-[1180px] px-6 py-5 text-xs text-text-faint sm:px-10">
      © 2026 {SITE.brand}. Giá niêm yết đã gồm VAT.
    </p>
  </div>
</footer>
